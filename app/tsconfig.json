{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@@/*": ["./frontend/js/*"],
      "@@css/*": ["./frontend/css/*"],
      "@@components/*": ["./frontend/js/components/*"],
    },
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true
  },
  "include": ["./frontend/**/*"],
  "exclude": ["node_modules"]
}